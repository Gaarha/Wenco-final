# Base de datos
DATABASE_URL="file:./dev.db"

# NextAuth (genera con: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-secreto-aleatorio-aqui"

# Google Drive - Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL="tu-cuenta@proyecto.iam.gserviceaccount.com"
# Pega el valor de private_key del JSON descargado (mantén los \n)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# ID de la carpeta de Google Drive (del URL: drive.google.com/drive/folders/ESTE_ID)
GOOGLE_DRIVE_FOLDER_ID="tu-folder-id-aqui"

# Email - Gmail SMTP
# Requiere: Google Account > Seguridad > Verificación 2 pasos > Contraseñas de aplicaciones
GMAIL_USER="tucorreo@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_ADMIN="admin@empresa.com"
